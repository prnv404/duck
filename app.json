{
  "expo": {
    "name": "Duck",
    "slug": "duck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/android/icons/android-icon-512.png",
    "scheme": "duck",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/ios/icons/ios-icon-1024.png",
      "splash": {
        "image": "./assets/ios/splash/ios-splash-2732x2732.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "icon": "./assets/android/icons/android-icon-512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/icons/android-icon-512.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/android/splash/android-splash-1920x1920.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "androidStatusBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ducklearning.duck",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android/splash/android-splash-1920x1920.png",
          "imageWidth": 200,
          "resizeMode": "native",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6580636-9ec4-44ae-9c68-547ea149c4dc"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}